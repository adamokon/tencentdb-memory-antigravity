# TencentDB Agent Memory Core/Gateway. This is NOT Memory Proxy (port 8096).
TAM_BASE_URL=http://127.0.0.1:8420

# Gateway API key used as: Authorization: Bearer <key>.
# In a local auth-disabled deployment, "local" is commonly accepted.
TAM_API_KEY=local

# Optional user key for a gateway/panel that requires x-tdai-user-key.
TAM_USER_KEY=

TAM_SERVICE_ID=default
TAM_TEAM_ID=default
TAM_AGENT_ID=antigravity
TAM_USER_ID=example-user
TAM_TASK_ID=

# Recall and failure behavior.
TAM_RECALL_LIMIT=5
TAM_RECALL_TIMEOUT_MS=3000
TAM_WRITE_TIMEOUT_MS=5000
TAM_MAX_CONTEXT_CHARS=12000
TAM_MAX_MEMORY_CHARS=2400
TAM_MAX_CAPTURE_CHARS=50000
TAM_RECALL_EVERY_INVOCATION=0

# Plain HTTP is accepted only for loopback by default. Set to 1 only on a
# trusted private network; HTTPS or a NetBird/WireGuard-bound listener is safer.
TAM_ALLOW_INSECURE_HTTP=0

# Optional directory for checkpoints and logs.
# TAM_STATE_DIR=/path/to/private/state
